#usda 1.0
(
    defaultPrim = "book"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "book" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00025602084, 0.0006731042, 0.00090308336)
    float physics:mass = 0.25
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:maxDepenetrationVelocity = 0.2
    float physxRigidBody:sleepThreshold = 0
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 8
    float physxRigidBody:stabilizationThreshold = 0

    def "Looks"
    {
        def Material "cover"
        {
            token outputs:surface.connect = </book/Looks/cover/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.22, 0.45)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "pages"
        {
            token outputs:surface.connect = </book/Looks/pages/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.9, 0.8)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "friction" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

    def Cube "collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </book/Looks/friction>
        float physxCollision:contactOffset = 0.0002
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.178, 0.108, 0.025)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "front_cover" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </book/Looks/cover>
        double size = 1
        float3 xformOp:scale = (0.178, 0.108, 0.0008)
        double3 xformOp:translate = (0, 0, 0.012100000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "back_cover" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </book/Looks/cover>
        double size = 1
        float3 xformOp:scale = (0.178, 0.108, 0.0008)
        double3 xformOp:translate = (0, 0, -0.012100000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "spine" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </book/Looks/cover>
        double size = 1
        float3 xformOp:scale = (0.178, 0.0008, 0.025)
        double3 xformOp:translate = (0, -0.0536, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "page_block" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </book/Looks/pages>
        double size = 1
        float3 xformOp:scale = (0.175, 0.105, 0.0234)
        double3 xformOp:translate = (0, 0.0005, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

