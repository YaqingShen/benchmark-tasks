#usda 1.0
(
    defaultPrim = "mailer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "mailer"
{
    def "Looks"
    {
        def Material "kraft"
        {
            token outputs:surface.connect = </mailer/Looks/kraft/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.26, 0.135, 0.055)
                float inputs:roughness = 0.87
                token outputs:surface
            }
        }

        def Material "cut_edge"
        {
            token outputs:surface.connect = </mailer/Looks/cut_edge/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.075, 0.025)
                float inputs:roughness = 0.87
                token outputs:surface
            }
        }

