                color3f inputs:diffuseColor = (0.98, 0.93, 0.81)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
            float physics:staticFriction = 0.75
        }

        def Material "clear_pet"
        {
            token outputs:mdl:surface.connect = </SoftServe/Looks/clear_pet/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:frosting_roughness = 0.02
                color3f inputs:glass_color = (0.98, 0.99, 1)
                float inputs:glass_ior = 1.57
                bool inputs:thin_walled = 1
                token outputs:out
            }
        }
    }

