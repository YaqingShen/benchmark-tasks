    def PhysicsRevoluteJoint "draw" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.02
        float drive:angular:physics:maxForce = 0.3
        float drive:angular:physics:stiffness = 0.16
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </SoftServe/base>
        rel physics:body1 = </SoftServe/lever>
