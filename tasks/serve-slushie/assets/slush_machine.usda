        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -80
        float physics:upperLimit = -15
    }

    def PhysicsFixedJoint "anchor"
    {
        rel physics:body1 = </SoftServe/base>
    }
