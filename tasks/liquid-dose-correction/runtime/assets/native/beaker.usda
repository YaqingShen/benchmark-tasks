    def Scope "Looks"
    {
        def Material "Borosilicate_glass"
        {
            token outputs:surface.connect = </beaker/Looks/Borosilicate_glass/Principled_BSDF.outputs:surface>

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.4, 0.69, 0.78)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:opacity = 0.22
                float inputs:roughness = 0.85
                float inputs:specular = 0
                token outputs:surface
            }
        }

