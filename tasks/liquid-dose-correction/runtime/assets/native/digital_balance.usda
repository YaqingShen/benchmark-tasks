        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.55
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "collisions"
    {
        def Cube "body" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </digital_balance/physics_material>
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.166, 0.159, 0.04)
            double3 xformOp:translate = (0, 0, 0.022)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
