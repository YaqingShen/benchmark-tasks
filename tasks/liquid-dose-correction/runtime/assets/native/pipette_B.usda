    def Scope "Looks"
    {
        def Material "Translucent_LDPE"
        {
            token outputs:surface.connect = </pipette_B/Looks/Translucent_LDPE/Principled_BSDF.outputs:surface>

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.5, 0.66, 0.74)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:opacity = 0.68
                float inputs:roughness = 0.85
                float inputs:specular = 0
                token outputs:surface
            }
        }
    }

    def Material "physics_material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.55
        float physics:restitution = 0
        float physics:staticFriction = 0.65
    }

    def Xform "collisions"
    {
        def Cylinder "stem" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.104
            rel material:binding:physics = </pipette_B/physics_material>
            uniform token purpose = "guide"
            double radius = 0.003
            double3 xformOp:translate = (0, 0, 0.052)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "bulb" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.047
            rel material:binding:physics = </pipette_B/physics_material>
            uniform token purpose = "guide"
            double radius = 0.012
            double3 xformOp:translate = (0, 0, 0.1325)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

