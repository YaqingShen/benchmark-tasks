#usda 1.0
(defaultPrim = "Asset"
 metersPerUnit = 1
 upAxis = "Z")

def Xform "Asset" (prepend apiSchemas = ["PhysicsRigidBodyAPI"]) {
bool physics:rigidBodyEnabled = true
bool physics:kinematicEnabled = true
def Material "Glass" {
 token outputs:surface.connect = </Asset/Glass/Surface.outputs:surface>
 def Shader "Surface" {
  uniform token info:id = "UsdPreviewSurface"
  color3f inputs:diffuseColor = (0.62, 0.83, 0.89)
  float inputs:opacity = 0.2
  float inputs:roughness = 0.35
  token outputs:surface
 }
}
def Material "Liquid" {
 token outputs:surface.connect = </Asset/Liquid/Surface.outputs:surface>
 def Shader "Surface" {
  uniform token info:id = "UsdPreviewSurface"
  color3f inputs:diffuseColor = (0.18, 0.65, 0.72)
  float inputs:opacity = 0.45
  float inputs:roughness = 0.35
  token outputs:surface
 }
}
def Material "Mark" {
 token outputs:surface.connect = </Asset/Mark/Surface.outputs:surface>
 def Shader "Surface" {
  uniform token info:id = "UsdPreviewSurface"
  color3f inputs:diffuseColor = (0.07, 0.12, 0.14)
  float inputs:opacity = 1.0
  float inputs:roughness = 0.35
  token outputs:surface
 }
}
def Cylinder "floor" (prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]) {
 double radius = 0.09
 double height = 0.006
 uniform token axis = "Z"
 double3 xformOp:translate = (0, 0, 0.003)
 uniform token[] xformOpOrder = ["xformOp:translate"]
 color3f[] primvars:displayColor = [(0.62, 0.83, 0.89)]
 rel material:binding = </Asset/Glass>
 float physxCollision:contactOffset = 0.0001
 float physxCollision:restOffset = 0
}
