 float physxCollision:restOffset = 0
}
}
def PhysicsPrismaticJoint "timer_button_slide" (prepend apiSchemas = ["PhysicsDriveAPI:linear"]) {
 rel physics:body0 = </Asset/timer_base>
 rel physics:body1 = </Asset/timer_button>
 token physics:axis = "Z"
 point3f physics:localPos0 = (0.032,-0.020,0.034)
 point3f physics:localPos1 = (0,0,0)
 float physics:lowerLimit = -0.003
 float physics:upperLimit = 0
 float drive:linear:physics:stiffness = 400
 float drive:linear:physics:damping = 1
 float drive:linear:physics:maxForce = 4
 float drive:linear:physics:targetPosition = 0
 float drive:linear:physics:targetVelocity = 0
 token drive:linear:physics:type = "force"
}
}