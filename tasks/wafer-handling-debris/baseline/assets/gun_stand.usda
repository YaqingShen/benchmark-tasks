#usda 1.0
(
 defaultPrim = "Asset"
 metersPerUnit = 1
 upAxis = "Z"
)
def Xform "Asset" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]) {
bool physics:rigidBodyEnabled = true
bool physics:kinematicEnabled = true
bool physxRigidBody:disableGravity = true
bool physxRigidBody:enableCCD = false
int physxRigidBody:solverPositionIterationCount = 64
int physxRigidBody:solverVelocityIterationCount = 4
def Material "stand_material" (prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]) {
float physics:staticFriction = 0.3
float physics:dynamicFriction = 0.3
float physics:restitution = 0
token physxMaterial:frictionCombineMode = "max"
}
def Cube "gun_stand" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
double3 xformOp:translate = (0, 0, 0)
quatf xformOp:orient = (1, 0, 0, 0)
color3f[] primvars:displayColor = [(0.18, 0.2, 0.22)]
float physxCollision:contactOffset = 0.0001
float physxCollision:restOffset = 0
rel material:binding:physics = </Asset/stand_material>
double size = 1
double3 xformOp:scale = (0.06, 0.06, 0.0105)
uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
}
}
