#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Xform "pedestal" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.0125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "pedestal" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.025
            custom rel material:binding:physics = </Asset/material_pedestal>
            bool physics:collisionEnabled = 1
            custom float physxCollision:contactOffset = 0.0001
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.45, 0.45, 0.48)]
            float[] primvars:displayOpacity = [1]
            double radius = 0.075
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def Material "material_pedestal" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:staticFriction = 0.5
        custom token physxMaterial:frictionCombineMode = "max"
    }

