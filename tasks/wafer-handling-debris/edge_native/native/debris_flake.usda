  int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
  int[] faceVertexIndices = [0, 1, 7, 0, 5, 1, 0, 6, 11, 0, 7, 6, 0, 11, 5, 1, 2, 7, 1, 3, 2, 1, 4, 3, 1, 5, 4, 2, 3, 8, 2, 8, 7, 3, 4, 10, 3, 9, 8, 3, 10, 9, 4, 5, 11, 4, 11, 10, 6, 7, 11, 7, 8, 9, 7, 9, 10, 7, 10, 11]
